        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "id": 2,
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"backend\",uri=\"/v1/move-evaluations\",method=\"POST\"}[1m]))) * 1000",
          "legendFormat": "p95",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_server_requests_seconds_bucket{job=\"backend\",uri=\"/v1/move-evaluations\",method=\"POST\"}[1m]))) * 1000",
          "legendFormat": "p99",
          "refId": "B"
        }
      ],
      "title": "Move Analysis Latency p95/p99",
      "type": "timeseries"
    },
    {
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "id": 3,
      "targets": [
        {
          "expr": "100 * ((sum(rate(http_server_requests_seconds_count{job=\"backend\",uri=\"/v1/move-evaluations\",method=\"POST\",status!~\"2..\"}[1m])) or vector(0)) / clamp_min((sum(rate(http_server_requests_seconds_count{job=\"backend\",uri=\"/v1/move-evaluations\",method=\"POST\"}[1m])) or vector(0)), 0.000001))",
          "legendFormat": "http non-2xx rate",
          "refId": "A"
        },
        {
          "expr": "100 * (clamp_min(((sum(rate(http_server_requests_seconds_count{job=\"backend\",uri=\"/v1/move-evaluations\",method=\"POST\"}[1m])) or vector(0)) - (sum(rate(http_server_requests_seconds_bucket{job=\"backend\",uri=\"/v1/move-evaluations\",method=\"POST\",le=\"0.5\"}[1m])) or vector(0))), 0) / clamp_min((sum(rate(http_server_requests_seconds_count{job=\"backend\",uri=\"/v1/move-evaluations\",method=\"POST\"}[1m])) or vector(0)), 0.000001))",
          "legendFormat": "SLA breach rate (>500ms)",
          "refId": "B"
        }
      ],
      "title": "Move Analysis Error/SLA Breach Rate",
      "type": "timeseries"
    },
