worker_processes auto;

events {
  worker_connections 1024;
}

stream {
  upstream stockfish_pool {
    least_conn;
{{- $servers := service "stockfish" -}}
{{- if gt (len $servers) 0 }}
{{- range $servers }}
    server {{ .Address }}:{{ .Port }};
{{- end }}
{{- else }}
    server 127.0.0.1:1;
{{- end }}
  }

  server {
    listen 5555;
    proxy_connect_timeout 3s;
    proxy_timeout 600s;
    proxy_pass stockfish_pool;
  }
}
